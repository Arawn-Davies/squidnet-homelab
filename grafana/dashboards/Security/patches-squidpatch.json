      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "squidpatch_upgradable",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "squidpatch_security_updates",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "squidpatch_critical_updates",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "squidpatch_reboot_required",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ],
      "title": "Per host",
      "transformations": [
        {
          "id": "merge"
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "key": true
            },
            "renameByName": {
              "Value #A": "updates",
              "Value #B": "security",
              "Value #C": "critical",
              "Value #D": "reboot"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "critical"
              }
            ]
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "5m",
  "tags": [
    "squidpatch",
    "security"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Patches (squidpatch)",
  "uid": "squidpatch"
}
