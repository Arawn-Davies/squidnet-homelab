# mailhost - internal only. See docker-compose.yml.
LOG_LEVEL=info
TZ=Europe/London
POSTMASTER_ADDRESS=postmaster@lab.example.co.uk
ONE_DIR=1
PERMIT_DOCKER=none
SPOOF_PROTECTION=1
ENABLE_UPDATE_CHECK=0
ENABLE_IMAP=1
ENABLE_POP3=0
ENABLE_MANAGESIEVE=0
ENABLE_QUOTAS=0
SSL_TYPE=manual
SSL_CERT_PATH=/certs/fullchain.pem
SSL_KEY_PATH=/certs/privkey.pem
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_AMAVIS=0
ENABLE_CLAMAV=0
ENABLE_SPAMASSASSIN=0
ENABLE_RSPAMD=0
ENABLE_POSTGREY=0
ENABLE_DNSBL=0
ENABLE_FAIL2BAN=0
ENABLE_SRS=0
ENABLE_OAUTH2=1
OAUTH2_INTROSPECTION_URL=https://auth.lab.example.co.uk/application/o/userinfo/
