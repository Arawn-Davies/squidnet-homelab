# /opt/romm/.env (root 600) - generated on the container, never committed
DB_HOST=romm-db
DB_NAME=romm
DB_USER=romm-user
DB_PASSWD=<openssl rand -hex 24>
DB_ROOT_PASSWD=<openssl rand -hex 24>
ROMM_AUTH_SECRET_KEY=<openssl rand -hex 32>
ROMM_BASE_URL=https://gaming.lab.example.co.uk
HASHEOUS_API_ENABLED=true
LAUNCHBOX_API_ENABLED=true
ENABLE_SCHEDULED_UPDATE_LAUNCHBOX_METADATA=true
ENABLE_RESCAN_ON_FILESYSTEM_CHANGE=true
RESCAN_ON_FILESYSTEM_CHANGE_DELAY=5
ENABLE_SCHEDULED_RESCAN=true
SCHEDULED_RESCAN_CRON=30 3 * * *
OIDC_ENABLED=true
OIDC_PROVIDER=Authentik
OIDC_CLIENT_ID=romm
OIDC_CLIENT_SECRET=<from Authentik, copied host-to-host>
OIDC_REDIRECT_URI=https://gaming.lab.example.co.uk/api/oauth/openid
OIDC_SERVER_APPLICATION_URL=https://auth.lab.example.co.uk/application/o/romm
# optional metadata keys (added later, hidden prompt): IGDB_CLIENT_ID/SECRET, SCREENSCRAPER_USER/PASSWORD, STEAMGRIDDB_API_KEY, RETROACHIEVEMENTS_API_KEY
