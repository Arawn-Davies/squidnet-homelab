# Every secret the configs in this repo reference. Copy to .env (git-ignored) and fill in.
# Domains: replace example.co.uk (public) and lab.example.co.uk (LAN-only) with your own, e.g.
#   grep -rl 'example.co.uk' . | xargs sed -i 's/lab\.example\.co\.uk/lab.mydomain.tld/g; s/example\.co\.uk/mydomain.tld/g'

# monitoring/proxmon (Grafana admin + Proxmox exporter API token, read-only PVEAuditor)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=
PVE_EXPORTER_USER=prometheus@pve
PVE_EXPORTER_TOKEN_NAME=exporter
PVE_EXPORTER_TOKEN_VALUE=

# SNMPv3 credentials for the switch (monitoring/proxmon snmp_auth)
SNMP_V3_USER=
SNMP_V3_AUTH_PASSWORD=
SNMP_V3_PRIV_PASSWORD=

# ntfy publisher token (write-only on squidnet-*): `ntfy token add alerts` on the ntfy host
NTFY_PUBLISH_TOKEN=

# suricata/usr/local/sbin/ids-mirror.sh - MACs excluded from the IDS mirror
PRIVATE_CT1_MAC=
PRIVATE_CT2_MAC=
BACKUP_CT_MAC=
FLAREON_MAC=
